<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema de arranque de Wayki Nest.

      Antes la app usaba `@android:style/Theme.Material.Light.NoActionBar`
      sin `windowBackground`: entre el splash del sistema y el primer frame
      de Compose se veía un flash blanco (o negro) genérico.

      Ahora el sistema pinta el fondo de marca con el ícono de la app y
      Compose entra con un fade suave (ver App.kt).
    -->
    <style name="Theme.WaykiNest" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/wayki_splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
