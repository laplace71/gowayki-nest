# Copia este archivo a .env (raíz del proyecto) y rellena los valores.
# El .env NO se sube al repositorio: está en .gitignore y no va en git.
# Las tres variables de autenticación son obligatorias para el build.
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_WEB_CLIENT_ID=
# Opcional: URL base del backend SOS en la red local (no es un secreto).
SOS_API_BASE_URL=